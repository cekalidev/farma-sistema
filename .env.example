APP_NAME=Laravel
APP_ENV=local
# Genérela con `php artisan key:generate` tras copiar este archivo a .env (también la usan los tests).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Zona horaria de la app (fechas de created_at, logs).
APP_TIMEZONE=America/Bogota
# Zona horaria de negocio: define "hoy" para vencimientos y vigencias (S-01, S-05).
# Independiente de APP_TIMEZONE; por defecto America/Bogota.
FARMA_ZONA_HORARIA=America/Bogota

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=farma
DB_USERNAME=farma
DB_PASSWORD=farma_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum (tokens Bearer) ---------------------------------------------------------------
# Minutos de validez de cada token emitido en el login (720 = 12 h); null = no expira (no recomendado).
SANCTUM_EXPIRATION=720

# --- FARTMAR (config/farma.php) ------------------------------------------------------------
# RN-11: días antes del vencimiento a partir de los cuales un lote genera alerta.
FARMA_DIAS_ALERTA_VENCIMIENTO=90
# Login: intentos por minuto por correo + IP (frena la fuerza bruta sobre una cuenta).
FARMA_LOGIN_INTENTOS_POR_MINUTO=5
# Login: intentos por minuto por correo desde cualquier IP (ataque distribuido).
FARMA_LOGIN_INTENTOS_POR_CORREO_POR_MINUTO=10
# Login: intentos por minuto por IP con cualquier correo (barrido de cuentas).
FARMA_LOGIN_INTENTOS_POR_IP_POR_MINUTO=20
# Límite general de /api/v1 autenticado: peticiones por minuto por usuario.
FARMA_API_PETICIONES_POR_MINUTO=60
# La semilla crea usuarios con contraseña de desarrollo conocida: con APP_ENV=production solo
# se ejecuta si esto es true (despliegue de demostración). Déjelo en false.
FARMA_PERMITIR_SEMILLA=false
